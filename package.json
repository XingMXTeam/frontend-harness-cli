{
  "bin": {
    "harness": "bin/harness.js"
  },
  "description": "A Harness kernel for long-running frontend AI coding: per-feature rubrics with veto evaluation, planner/developer/evaluator role agents with kernel-enforced isolation, an authoring skill chain, Playwright evidence capture with pixel diff, and a vendored five-dimension code sensor. Host-agnostic; frontend-first.",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "harness",
    "agents",
    "claude-code",
    "codex",
    "evaluation",
    "rubric",
    "cli",
    "developer-tools",
    "playwright",
    "visual-regression"
  ],
  "license": "MIT",
  "name": "frontend-harness-cli",
  "scripts": {
    "demo": "bash examples/demo.sh",
    "test": "node --test test/*.test.js",
    "demo:run": "bash examples/demo-run.sh",
    "example": "bash examples/notice-list/run.sh"
  },
  "type": "module",
  "version": "0.8.0",
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "pixelmatch": ">=5.3.0",
    "pngjs": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "pixelmatch": {
      "optional": true
    },
    "pngjs": {
      "optional": true
    }
  }
}
